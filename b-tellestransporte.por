programa {
  funcao inicio() {
    // entendimento
      // calcular o valor do frete 
    // infos
    real distancia, peso, volume
    real frete 
    // entrada de dados 
    escreva("Digite o peso: ")
    leia(peso)
    escreva("Digite o volume: ")
    leia(volume)
    escreva("Digite a distancia: ")
    leia(distancia)
    // processamento
    frete=15+(2*peso)+(0.05*distancia)+(10*volume) 
     // saídas
    // mostrar resultados
     escreva("Valor do frete: R$" + frete) 













  }
}
